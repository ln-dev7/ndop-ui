{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "baseBranch": "master",
  "access": "public",
  "format": "auto",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "changedFilePatterns": [
    "package.json",
    "README.md",
    "ng-package.json",
    "styles.css",
    "src/**",
    "*/src/**",
    "*/README.md",
    "*/spec.md",
    "*/ng-package.json",
    "!**/*.spec.ts",
    "!**/__snapshots__/**",
    "!src/testing/**"
  ],
  "ignore": [],
  "fixed": [
    [
      "@ndop/cli",
      "@ndop/core",
      "@ndop/primitives",
      "@ndop/schema",
      "@ndop/metadata",
      "@ndop/merge",
      "@ndop/verify",
      "@ndop/mcp",
      "@ndop/eslint-plugin"
    ]
  ],
  "linked": [],
  "updateInternalDependencies": "patch",
  "privatePackages": { "version": false, "tag": false }
}
