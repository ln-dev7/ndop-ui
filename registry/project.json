{
  "name": "registry",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "registry",
  "prefix": "nd",
  "projectType": "library",
  "tags": ["type:registry"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "@ndop/workspace-plugin:registry-build",
      "outputs": ["{workspaceRoot}/dist/registry"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/packages/cli/src/**/*",
        "{workspaceRoot}/packages/schema/src/**/*",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "env": "CI"
        }
      ],
      "options": {
        "outputPath": "dist/registry",
        "tsconfig": "tsconfig.base.json"
      }
    }
  },
  "implicitDependencies": ["eslint-plugin"]
}
