{
  "name": "registry",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "registry",
  "prefix": "nd",
  "projectType": "library",
  "tags": ["type:registry"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "@ndop/workspace-plugin:registry-build",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/registry", "{projectRoot}/snapshots"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/packages/cli/src/**/*",
        "{workspaceRoot}/packages/schema/src/**/*",
        "{workspaceRoot}/tools/workspace-plugin/src/executors/registry-build/**/*",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "env": "CI"
        },
        {
          "env": "NDOP_REGISTRY"
        },
        {
          "externalDependencies": [
            "typescript",
            "@angular/compiler-cli",
            "@angular/core",
            "@angular/common",
            "@angular/forms",
            "@angular/cdk",
            "@lucide/angular"
          ]
        }
      ],
      "options": {
        "outputPath": "dist/registry",
        "tsconfig": "tsconfig.base.json",
        "compat": "shadcn"
      }
    }
  },
  "implicitDependencies": ["eslint-plugin"]
}
