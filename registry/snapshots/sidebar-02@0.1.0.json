  "version": "0.1.0",
  "title": "Sidebar 02",
  "description": "An app shell whose sidebar collapses to icons and opens as a sheet on mobile.",
  "dependencies": [
    "@ndop/core"
  ],
  "registryDependencies": [
    "avatar",
    "breadcrumb",
