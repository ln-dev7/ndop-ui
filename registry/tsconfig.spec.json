{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ]
  },
  "include": [
    "vite.config.mts",
    "ui/**/*.spec.ts",
    "lib/**/*.spec.ts",
    "examples/**/*.spec.ts",
    "blocks/**/*.spec.ts",
    "**/*.d.ts",
    "testing/**/*.ts"
  ],
  "files": ["test-setup.ts"]
}
