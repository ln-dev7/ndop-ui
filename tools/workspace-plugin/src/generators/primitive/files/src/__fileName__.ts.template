import { Directive } from '@angular/core';

/**
 * Headless <%= className %> primitive. Owns behavior and accessibility and
 * renders no styles; its roles, keyboard map, focus and RTL rules are in
 * `spec.md` at the root of this entry point.
 *
 * @example
 * ```html
 * <div nd<%= className %>></div>
 * ```
 */
@Directive({
  selector: '[nd<%= className %>]',
})
export class Nd<%= className %> {}
