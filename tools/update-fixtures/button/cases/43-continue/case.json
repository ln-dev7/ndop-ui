{
  "kind": "behavior",
  "item": "button",
  "from": "1.0.0",
  "to": "1.1.0",
  "description": "Resolve the conflict by hand: update reports it pending until --continue records it.",
  "runs": [
    {
      "expect": {
        "conflict": true,
        "statuses": {
          "src/app/ui/button/button.ts": "conflict"
        }
      }
    },
    {
      "overlay": "resolved",
      "commit": true,
      "expect": {
        "exit": 2,
        "statuses": {
          "src/app/ui/button/button.ts": "pending"
        }
      }
    },
    {
      "args": [
        "--continue"
      ],
      "expected": "resolved",
      "expect": {
        "statuses": {
          "src/app/ui/button/button.ts": "resolved"
        }
      }
    }
  ]
}
