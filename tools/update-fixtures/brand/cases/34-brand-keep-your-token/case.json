{
  "description": "Change --brand in light mode, which upstream changes too: yours stays, with a warning, and dark mode still updates.",
  "kind": "merge",
  "item": "brand",
  "from": "1.0.0",
  "to": "2.0.0",
  "replace": [
    {
      "path": "src/styles.css",
      "find": "--brand: oklch(0.55 0.2 260)",
      "with": "--brand: oklch(0.6 0.25 300)"
    }
  ],
  "expect": {
    "statuses": {
      "src/app/lib/brand.ts": "unchanged"
    },
    "contains": {
      "src/styles.css": [
        "--brand: oklch(0.6 0.25 300)",
        "--brand: oklch(0.65 0.2 265)",
        "--brand-muted: oklch(0.95 0.03 260)"
      ]
    },
    "warnings": [
      "Kept your value of --brand in :root"
    ]
  }
}
