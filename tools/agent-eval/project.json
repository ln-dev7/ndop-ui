  "projectType": "application",
  "tags": ["type:e2e"],
  "implicitDependencies": ["cli", "ndop", "mcp", "verify", "registry"],
  "targets": {
    "eval": {
      "executor": "@ndop/workspace-plugin:agent-eval",
