{
  "name": "@ndop/schema",
  "version": "1.1.1",
  "description": "JSON schemas and types for Ndop UI registries, registry items, ndop.json, ndop.lock.json and component metadata.",
  "license": "MIT",
  "homepage": "https://ndop.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndop-ui/ui.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/ndop-ui/ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/packages/schema",
    "linkDirectory": false
  },
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-ts": "3.1.1",
    "tslib": "^2.3.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./theme": {
      "types": "./src/theme.d.ts",
      "default": "./src/theme.js"
    },
    "./package.json": "./package.json"
  }
}
