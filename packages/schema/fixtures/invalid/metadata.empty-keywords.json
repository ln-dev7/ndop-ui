{
  "$schema": "https://ndop.dev/schema/metadata.json",
  "name": "dialog",
  "title": "Dialog",
  "description": "A window overlaid on the primary window, rendering the content underneath inert.",
  "intro": "Use a dialog to ask for a decision or input that blocks the page until it is answered.",
  "keywords": [],
  "agentNotes": {
    "do": ["Give every dialog a `DialogTitle`."],
    "dont": ["Don't open a dialog from another dialog."]
  },
  "pattern": {
    "name": "Dialog (Modal)",
    "url": "https://www.w3.org/WAI/ARIA/apg/patterns/dialog-modal/"
  },
  "parts": [
    {
      "name": "NdDialogTrigger",
      "selector": "[ndDialogTrigger]",
      "requires": ["[ndDialog]"],
      "description": "Opens and closes the dialog it belongs to.",
      "ariaAttributes": ["aria-haspopup", "aria-expanded", "aria-controls"],
      "inputs": [],
      "models": [
        {
          "name": "open",
          "type": "boolean",
          "default": "false",
          "description": "Whether the dialog is open."
        }
      ],
      "outputs": [],
      "hostBindings": [
        {
          "name": "attr.aria-expanded",
          "value": "ctx.open()"
        }
      ],
      "dataAttributes": [
        {
          "name": "data-state",
          "values": ["open", "closed"],
          "description": "Open state, for styling."
        }
      ],
      "source": "@ndop/primitives/dialog"
    }
  ],
  "keyboard": [
    {
      "keys": ["Enter", "Space"],
      "action": "Opens the dialog from the trigger."
    },
    {
      "keys": ["Escape"],
      "action": "Closes the dialog."
    }
  ],
  "focus": [
    "Focus moves to the first focusable element on open.",
    "Focus returns to the trigger on close."
  ],
  "rtl": "No directional behavior.",
  "examples": ["dialog-demo", "dialog-form"],
  "bundleSize": {
    "gzip": 812
  }
}
