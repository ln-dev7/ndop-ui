exports[`ndop view > prints a block's notes, and no API 1`] = `
"Login 01  login-01 1.0.0, block
A sign-in form in a card, with email and password.

  Install  npx @ndop/cli add login-01
  Docs     https://ndop.dev/blocks/login-01
  Angular  21.0.0 or later, SSR, zoneless

Dependencies
  registry  button

Files
  {blocks}/login-01/login-01.ts

Notes
  Route to it, for example: { path: 'login', loadComponent: () =>
  import('./blocks/login-01/login-01').then((m) => m.Login01Block) }
"
`;

exports[`ndop view > prints a component's API, keyboard map and examples 1`] = `
"Button  button 1.0.0, component
Displays a button or a component that looks like a button.

Buttons start actions. \`ndButton\` styles a native \`button\`, or an \`a\` when the
action navigates.

  Install  npx @ndop/cli add button
  Docs     https://ndop.dev/docs/components/button
  Pattern  Button, https://www.w3.org/WAI/ARIA/apg/patterns/button/
  Angular  21.0.0 or later, SSR, zoneless
  Size     1.0 kB gzip

Dependencies
  npm       @ndop/primitives
  registry  utils

Files
  {ui}/button/button.ts

Usage
  import { Button } from '@/ui/button/button';

  <button ndButton>Save</button>

API
  Button  button[ndButton], a[ndButton]
    Styled button for a native \`button\` or an \`a\`, with the \`NdButton\` behavior.
    Role        native (button / link)
    [variant]   'default' | 'destructive' | 'outline' | 'secondary' | 'ghost' |
                'link' = 'default'
                Visual style.
    [disabled]  boolean = false
                Whether the button or link is disabled.
    Data        data-slot (button), data-variant

Keyboard
  Enter  Activates the button, or follows the link; does nothing while disabled.
  Space  Activates a \`button\`.

Focus
  - A disabled \`button\` is removed from the tab order.

Right to left
  Nothing mirrors.

Examples
  button-demo  The six button variants.
  button-link  A link that looks like a button.

  Add --code to print their source.
"
`;

