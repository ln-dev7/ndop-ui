{
  "name": "@ndop/cli",
  "version": "0.0.1",
  "description": "The ndop CLI: init, add, list, view, diff, update, doctor, verify and build for Ndop UI registries.",
  "license": "MIT",
  "homepage": "https://ndop.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndop-ui/ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ndop-ui/ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/packages/cli",
    "linkDirectory": false
  },
  "type": "module",
  "exports": {
    ".": "./main.js",
    "./api": "./api.js"
  },
  "bin": {
    "ndop": "./main.js"
  },
  "files": [
    "main.js",
    "main.js.map",
    "api.js",
    "api.js.map",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@ndop/merge": "workspace:^",
    "@ndop/metadata": "workspace:^",
    "@ndop/schema": "workspace:^",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "jsonc-parser": "3.3.1",
    "package-manager-detector": "1.8.0",
    "picocolors": "1.1.1",
    "postcss": "8.5.28",
    "tinyexec": "1.3.1",
    "ts-morph": "28.0.0"
  },
  "peerDependencies": {
    "@ndop/verify": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@ndop/verify": {
      "optional": true
    }
  }
}
