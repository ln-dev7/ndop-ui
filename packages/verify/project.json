{
  "name": "verify",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/verify/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        {
          "path": "dist/{projectRoot}",
          "preserveLocalDependencyProtocols": false
        }
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["type:tooling"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "main": "packages/verify/src/index.ts",
        "outputPath": "dist/packages/verify",
        "tsConfig": "packages/verify/tsconfig.lib.json",
        "platform": "node",
        "format": ["esm"],
        "assets": [
          {
            "glob": "README.md",
            "input": "packages/verify",
            "output": "."
          },
          {
            "glob": "package.json",
            "input": "packages/verify",
            "output": "."
          }
        ],
        "thirdParty": false,
        "generatePackageJson": false,
        "esbuildOptions": {
          "sourcemap": true
        },
        "external": ["@ndop/schema", "@ndop/metadata", "@ndop/eslint-plugin"],
        "outputFileName": "index.js"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/packages/verify"
      ],
      "options": {
        "coverage.reportsDirectory": "../../coverage/packages/verify"
      }
    }
  }
}
