{
  "name": "primitives",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/primitives",
  "prefix": "nd",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["type:primitives"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/primitives/ng-package.json",
        "tsConfig": "packages/primitives/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/primitives/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "providersFile": "packages/primitives/test-providers.ts"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "api": {
      "executor": "@ndop/workspace-plugin:primitives-api",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/primitives-api"],
      "inputs": [
        "production",
        "{workspaceRoot}/packages/metadata/src/**/*",
        "{workspaceRoot}/tools/workspace-plugin/src/executors/primitives-api/**/*"
      ]
    }
  }
}
