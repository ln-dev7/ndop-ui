{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "docs",
  "sourceRoot": "apps/docs/src",
  "tags": ["type:app"],
  "implicitDependencies": ["registry", "metadata"],
  "targets": {
    "build": {
      "executor": "@analogjs/platform:vite",
      "defaultConfiguration": "production",
      "outputs": ["{workspaceRoot}/dist/apps/docs"],
      "options": {
        "configFile": "apps/docs/vite.config.ts",
        "main": "apps/docs/src/main.ts",
        "outputPath": "dist/apps/docs/client",
        "tsConfig": "apps/docs/tsconfig.app.json"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "sourcemap": false,
          "mode": "production"
        }
      },
      "dependsOn": [
        "^build",
        {
          "projects": ["primitives"],
          "target": "api"
        },
        {
          "projects": ["size"],
          "target": "check"
        }
      ]
    },
    "serve": {
      "executor": "@analogjs/platform:vite-dev-server",
      "continuous": true,
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "docs:build",
        "port": 4200
      },
      "configurations": {
        "development": {
          "buildTarget": "docs:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "docs:build:production"
        }
      },
      "dependsOn": [
        "^build",
        {
          "projects": ["primitives"],
          "target": "api"
        },
        {
          "projects": ["size"],
          "target": "check"
        }
      ]
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "guides": {
      "executor": "@ndop/workspace-plugin:docs-guides",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/guides/**/*.md",
        "{workspaceRoot}/registry/**/*",
        "{workspaceRoot}/packages/core/src/**/*",
        "{workspaceRoot}/packages/primitives/**/*",
        "{workspaceRoot}/packages/schema/src/**/*",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tools/workspace-plugin/src/executors/docs-guides/**/*",
        {
          "dependentTasksOutputFiles": "**/*.json"
        },
        {
          "externalDependencies": [
            "typescript",
            "@angular/compiler-cli",
            "@angular/core",
            "@angular/cdk"
          ]
        }
      ],
      "outputs": [],
      "dependsOn": [
        {
          "projects": ["registry"],
          "target": "build"
        }
      ],
      "options": {
        "guides": "apps/docs/src/guides"
      }
    },
    "typecheck": {
      "dependsOn": ["guides"]
    },
    "serve-static": {
      "executor": "@ndop/workspace-plugin:serve-site",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "dir": "dist/apps/docs/analog/public",
        "port": 4400
      }
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test",
      "inputs": ["default", "^default", "{workspaceRoot}/ROADMAP.md"],
      "options": {
        "config": "vite.config.ts"
      },
      "dependsOn": ["^build"]
    },
    "lighthouse": {
      "executor": "@ndop/workspace-plugin:docs-lighthouse",
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/lighthouse/docs"],
      "options": {
        "dir": "dist/apps/docs/analog/public",
        "outputDir": "dist/lighthouse/docs"
      }
    }
  }
}
