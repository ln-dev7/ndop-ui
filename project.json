{
  "name": "@ndop/source",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    },
    "release-version": {
      "executor": "@ndop/workspace-plugin:release-version",
      "cache": false
    },
    "release-bootstrap": {
      "executor": "@ndop/workspace-plugin:release-bootstrap",
      "cache": false
    },
    "changeset-status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "changeset status"
      },
      "cache": false
    }
  }
}
