{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "harness",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["nx", "serve", "harness"],
      "port": 4300
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["nx", "serve", "docs"],
      "port": 4200
    },
    {
      "name": "docs-static",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "nx",
        "run",
        "docs:serve-static",
        "--excludeTaskDependencies"
      ],
      "port": 4400
    }
  ]
}
