{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@ndop/primitives": ["./packages/primitives/src/index.ts"],
      "@ndop/core": ["./packages/core/src/index.ts"],
      "@ndop/schema": ["./packages/schema/src/index.ts"],
      "@ndop/cli": ["./packages/cli/src/index.ts"],
      "@ndop/cli/api": ["./packages/cli/src/api.ts"],
      "@ndop/mcp": ["./packages/mcp/src/index.ts"],
      "@ndop/metadata": ["./packages/metadata/src/index.ts"],
      "@ndop/eslint-plugin": ["./packages/eslint-plugin/src/index.ts"],
      "@ndop/eslint-plugin/catalog": [
        "./packages/eslint-plugin/src/lib/catalog.ts"
      ],
      "@ndop/workspace-plugin": ["./tools/workspace-plugin/src/index.ts"],
      "@ndop/primitives/separator": [
        "./packages/primitives/separator/src/index.ts"
      ],
      "@ndop/primitives/label": ["./packages/primitives/label/src/index.ts"],
      "@ndop/primitives/button": ["./packages/primitives/button/src/index.ts"],
      "@ndop/primitives/input": ["./packages/primitives/input/src/index.ts"],
      "@ndop/primitives/dialog": ["./packages/primitives/dialog/src/index.ts"],
      "@ndop/primitives/popover": [
        "./packages/primitives/popover/src/index.ts"
      ],
      "@ndop/primitives/tooltip": [
        "./packages/primitives/tooltip/src/index.ts"
      ],
      "@ndop/primitives/internal": [
        "./packages/primitives/internal/src/index.ts"
      ],
      "@/*": ["./registry/*"],
      "@ndop/verify": ["./packages/verify/src/index.ts"],
      "@ndop/merge": ["./packages/merge/src/index.ts"],
      "@ndop/primitives/collapsible": [
        "./packages/primitives/collapsible/src/index.ts"
      ],
      "@ndop/primitives/avatar": ["./packages/primitives/avatar/src/index.ts"],
      "@ndop/primitives/progress": [
        "./packages/primitives/progress/src/index.ts"
      ],
      "@ndop/primitives/input-otp": [
        "./packages/primitives/input-otp/src/index.ts"
      ],
      "@ndop/primitives/form-field": [
        "./packages/primitives/form-field/src/index.ts"
      ],
      "@ndop/primitives/checkbox": [
        "./packages/primitives/checkbox/src/index.ts"
      ],
      "@ndop/primitives/switch": ["./packages/primitives/switch/src/index.ts"],
      "@ndop/primitives/toggle": ["./packages/primitives/toggle/src/index.ts"],
      "@ndop/primitives/radio-group": [
        "./packages/primitives/radio-group/src/index.ts"
      ],
      "@ndop/primitives/toggle-group": [
        "./packages/primitives/toggle-group/src/index.ts"
      ],
      "@ndop/primitives/slider": ["./packages/primitives/slider/src/index.ts"],
      "@ndop/primitives/alert-dialog": [
        "./packages/primitives/alert-dialog/src/index.ts"
      ],
      "@ndop/primitives/drawer": ["./packages/primitives/drawer/src/index.ts"],
      "@ndop/primitives/hover-card": [
        "./packages/primitives/hover-card/src/index.ts"
      ],
      "@ndop/primitives/menu": ["./packages/primitives/menu/src/index.ts"],
      "@ndop/primitives/dropdown-menu": [
        "./packages/primitives/dropdown-menu/src/index.ts"
      ],
      "@ndop/primitives/context-menu": [
        "./packages/primitives/context-menu/src/index.ts"
      ],
      "@ndop/primitives/toast": ["./packages/primitives/toast/src/index.ts"],
      "@ndop/primitives/tabs": ["./packages/primitives/tabs/src/index.ts"],
      "@ndop/primitives/accordion": [
        "./packages/primitives/accordion/src/index.ts"
      ],
      "@ndop/primitives/resizable": [
        "./packages/primitives/resizable/src/index.ts"
      ],
      "@ndop/primitives/menubar": [
        "./packages/primitives/menubar/src/index.ts"
      ],
      "@ndop/primitives/navigation-menu": [
        "./packages/primitives/navigation-menu/src/index.ts"
      ],
      "@ndop/primitives/select": ["./packages/primitives/select/src/index.ts"],
      "@ndop/primitives/combobox": [
        "./packages/primitives/combobox/src/index.ts"
      ],
      "@ndop/primitives/command": ["./packages/primitives/command/src/index.ts"]
    },
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "exclude": ["node_modules", "tmp"]
}
